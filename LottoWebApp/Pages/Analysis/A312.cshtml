@page
@model LottoWebApp.Pages.Analysis.A312Model
@using System.Text.Json;
@using System.Text.Json.Serialization;
@{
    ViewData["Title"] = "3.12 Карта распределения четных и нечетных чисел в квадратах 2x2";

    // --- Группируем данные ---
    var groupedResults = Model.SquareDistributionResults
        .GroupBy(r => r.SquareNumber)
        .OrderBy(g => g.Key)
        .ToList();

    // --- данные для JavaScript ---
    var chartData = groupedResults.ToDictionary(
        g => g.Key.ToString(), // Ключ (напр., "1")
        g => g.Select(item => new
        { // Значение (массив)
            
            Label = $"Ч{item.EvenCount}Н{item.OddCount}",
            Count = item.Count,
            Chance = item.Chance,
            Even = item.EvenCount,
            Odd = item.OddCount
        }).ToList()
    );

    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" class="mb-4">
        <input type="hidden" name="Game" value="@Model.Game" />
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="DrawCount" class="form-label">Количество тиражей (0 - все)</label>
                <input type="number" name="DrawCount" id="DrawCount" class="form-control" min="0" value="@(Model.DrawCount > 0 ? Model.DrawCount : 0)" />
            </div>
            <div class="col-md-4">
                <label for="Direction" class="form-label">Направление</label>
                <select name="Direction" id="Direction" class="form-select">
                    <option value="newToOld" selected="@(Model.Direction == "newToOld")">Сначала новые</option>
                    <option value="oldToNew" selected="@(Model.Direction == "oldToNew")">Сначала старые</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Построить карту</button>
                @if (Model.SquareDistributionResults.Any())
                {
                    <button type="submit" asp-page-handler="DownloadCsv" class="btn btn-success w-100 mt-2">💾 Скачать CSV</button>
                }
            </div>
        </div>
    </form>

    @if (groupedResults.Any())
    {
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tableTab">📋 Общая таблица</button>
            </li>

            @foreach (var group in groupedResults)
            {
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chartTab_@group.Key">
                        📊 Квадрат @group.Key
                    </button>
                </li>
            }
        </ul>

        <div class="tab-content mt-3">
            @* --- Вкладка 1: Общая таблица --- *@
            <div class="tab-pane fade show active" id="tableTab">
                <div class="table-responsive">
                    <table class="table table-dark table-bordered text-center">
                        <thead>
                            <tr>
                                <th>№ Квадрата</th>
                                <th>Четные</th>
                                <th>Нечетные</th>
                                <th>Количество</th>
                                <th>Числа квадрата (Комбинация)</th>
                                <th>Шанс</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in Model.SquareDistributionResults)
                            {
                                <tr>
                                    <td>@result.SquareNumber</td>
                                    <td>@result.EvenCount</td>
                                    <td>@result.OddCount</td>
                                    <td>@result.Count</td>
                                    <td>@result.SquareCells</td>
                                    <td>@result.Chance</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @foreach (var group in groupedResults)
            {
                <div class="tab-pane fade" id="chartTab_@group.Key">
                    <h4>Анализ: Квадрат @group.Key</h4>
                    <p>
                        График показывает распределение комбинаций (Четные-Нечетные)
                        внутри этого квадрата за выбранный период.
                    </p>

                    <div style="height: 500px; margin: auto;">
                        <canvas id="chartCanvas_@group.Key"></canvas>
                    </div>

                    <button class="btn btn-info mt-3"
                            onclick="downloadChart('chartCanvas_@group.Key', 'A312_Square_@(group.Key).png')">
                        📥 Скачать (PNG)
                    </button>

                    <h5 class="mt-4">Данные для Квадрата @group.Key</h5>
                    <div class="table-responsive">
                        <table class="table table-dark table-bordered text-center">
                            <thead>
                                <tr>
                                    <th>Комбинация</th>
                                    <th>Четные</th>
                                    <th>Нечетные</th>
                                    <th>Количество</th>
                                    <th>Шанс</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group.OrderByDescending(i => i.Count))
                                {
                                    <tr>
                                        <td>@item.SquareCells</td>
                                        <td>@item.EvenCount</td>
                                        <td>@item.OddCount</td>
                                        <td>@item.Count</td>
                                        <td>@item.Chance</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    @if (groupedResults.Any())
    {
            // --- Передаем сгруппированные данные в JS ---
            @:const allGroupedData = @Html.Raw(JsonSerializer.Serialize(chartData, jsonOptions));

            // Хранилище для ссылок на созданные графики
            @:const chartInstances = {};

            @:document.addEventListener("DOMContentLoaded", function() {
            @:    document.querySelectorAll('.nav-link[data-bs-target^="#chartTab_"]').forEach(tabButton => {
            @:        tabButton.addEventListener('shown.bs.tab', function() {
            @:            const squareNumber = this.getAttribute('data-bs-target').replace('#chartTab_', '');
            @:            const canvasId = `chartCanvas_${squareNumber}`;
            @:
            @:            if (!chartInstances[canvasId]) {
            @:                const ctx = document.getElementById(canvasId)?.getContext('2d');
            @:                let dataForThisSquare = allGroupedData[squareNumber];
            @:
            @:                if (ctx && dataForThisSquare) {
            @:                    dataForThisSquare.sort((a, b) => b.count - a.count);
            @:
            @:                    const labels = dataForThisSquare.map(r => r.label); // "Ч4Н0"
            @:                    const values = dataForThisSquare.map(r => r.count); // 50
            @:                    const chances = dataForThisSquare.map(r => r.chance); // 10.5%
            @:
            @:                    chartInstances[canvasId] = new Chart(ctx, {
            @:                        type: 'bar',
            @:                        data: {
            @:                            labels: labels,
            @:                            datasets: [{
            @:                                label: 'Количество выпадений',
            @:                                data: values,
            @:                                backgroundColor: 'rgba(54, 162, 235, 0.8)',
            @:                                borderWidth: 1
            @:                            }]
            @:                        },
            @:                        options: {
            @:                            responsive: true,
            @:                            maintainAspectRatio: false,
            @:                            scales: { y: { beginAtZero: true } },
            @:                            plugins: {
            @:                                tooltip: {
            @:                                    callbacks: {
            @:                                        label: function(context) {
            @:                                            const index = context.dataIndex;
            @:                                            const count = context.parsed.y || 0;
            @:                                            const chance = chances[index] || 0;
            @:                                            return [
            @:                                                `Кол-во: ${count}`,
            @:                                                `Шанс: ${chance}%`
            @:                                            ];
            @:                                        }
            @:                                    }
            @:                                },
            @:                                legend: {
            @:                                    display: false 
            @:                                }
            @:                            }
            @:                        }
            @:                    });
            @:                }
            @:            }
            @:        });
            @:    });
            @:});

            // Универсальная функция скачивания
            @:window.downloadChart = function(canvasId, filename) {
            @:    const chart = chartInstances[canvasId];
            @:    if (chart) {
            @:        const link = document.createElement('a');
            @:        link.href = chart.toBase64Image();
            @:        link.download = filename;
            @:        link.click();
            @:    } else {
            @:        alert("График не найден. Попробуйте перезагрузить страницу.");
            @:    }
            @:};
    }
</script>