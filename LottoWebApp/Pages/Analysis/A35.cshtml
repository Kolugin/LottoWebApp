@page
@model LottoWebApp.Pages.Analysis.A35Model
@{
    ViewData["Title"] = "3.5 Карта четности и нечетности";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" class="mb-4">
        <input type="hidden" name="Game" value="@Model.Game" />
        <div class="row">
            <div class="col-md-4">
                <label for="DrawCount" class="form-label">Количество тиражей (0 - все)</label>
                <input type="number" name="DrawCount" id="DrawCount" class="form-control" min="0" value="@(Model.DrawCount > 0 ? Model.DrawCount : 0)" />
            </div>
            <div class="col-md-4">
                <label for="Direction" class="form-label">Направление</label>
                <select name="Direction" id="Direction" class="form-select">
                    <option value="newToOld" selected="@(Model.Direction == "newToOld")">Сначала новые</option>
                    <option value="oldToNew" selected="@(Model.Direction == "oldToNew")">Сначала старые</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Построить карту четности</button>
                @if (Model.ResultsTable != null)
                {
                    <button type="submit" asp-page-handler="DownloadCsv" class="btn btn-success w-100 mt-2">💾 Скачать CSV</button>
                }
            </div>
        </div>
    </form>

    @if (Model.ResultsTable != null)
    {
        <div class="table-responsive">
            <table class="table table-dark table-bordered text-center">
                <thead>
                    <tr>
                        <th>Тираж</th>
                        <th>Дата</th>
                        @for (int i = 1; i <= Model.NumberOfBalls; i++)
                        {
                            <th>№П @i</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.ResultsTable.Rows.Count; i++)
                    {
                        <tr>
                            <td>@Model.ResultsTable.Rows[i]["Тираж"]</td>
                            <td>@Model.ResultsTable.Rows[i]["Дата"]</td>
                            @for (int j = 1; j <= Model.NumberOfBalls; j++)
                            {
                                <td class="@(Model.ResultsTable.Rows[i][$"№П {j}"].ToString() == "Ч" ? "even-cell" : "odd-cell")">@Model.ResultsTable.Rows[i][$"№П {j}"]</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .even-cell {
        background-color: #28a745;
    }

    .odd-cell {
        background-color: #dc3545;
    }
</style>