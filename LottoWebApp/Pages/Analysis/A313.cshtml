@page
@model LottoWebApp.Pages.Analysis.A313Model
@using System.Text.Json;
@{
    ViewData["Title"] = "3.13 Карта распределения сумм чисел";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" class="mb-4">
        <input type="hidden" name="Game" value="@Model.Game" />
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="DrawCount" class="form-label">Количество тиражей (0 - все)</label>
                <input type="number" name="DrawCount" id="DrawCount" class="form-control" min="0" value="@(Model.DrawCount > 0 ? Model.DrawCount : 0)" />
            </div>
            <div class="col-md-4">
                <label for="Direction" class="form-label">Направление</label>
                <select name="Direction" id="Direction" class="form-select">
                    <option value="newToOld" selected="@(Model.Direction == "newToOld")">Сначала новые</option>
                    <option value="oldToNew" selected="@(Model.Direction == "oldToNew")">Сначала старые</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Построить карту распределения сумм</button>
                @if (Model.SumDistributionResults.Any())
                {
                    <button type="submit" asp-page-handler="DownloadCsv" class="btn btn-success w-100 mt-2">💾 Скачать CSV</button>
                }
            </div>
        </div>
    </form>

    @if (Model.SumDistributionResults.Any())
    {
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tableTab">📋 Таблица</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chartTab">📊 График</button>
            </li>
        </ul>

        <div class="tab-content mt-3">
            <div class="tab-pane fade show active" id="tableTab">
                <div class="table-responsive">
                    <table class="table table-dark table-bordered text-center">
                        <thead>
                            <tr>
                                <th>Сумма выпавших</th>
                                <th>Сумма невыпавших</th>
                                <th>Частота</th>
                                <th>Шанс (%)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in Model.SumDistributionResults)
                            {
                                <tr>
                                    <td>@result.SumHit</td>
                                    <td>@result.SumMissed</td>
                                    <td>@result.Frequency</td>
                                    <td>@result.Probability</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="chartTab">
                <h3>Распределение частоты сумм чисел</h3>
                <p>График показывает, как часто встречались различные суммы выпавших чисел.</p>
                <div style="height: 500px;">
                    <canvas id="sumDistributionChart"></canvas>
                </div>

                <button class="btn btn-info mt-3" onclick="downloadChart()">📥 Скачать (PNG)</button>
            </div>
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Хранилище для экземпляра графика
    let sumChartInstance = null;

    @if (Model.SumDistributionResults.Any())
    {
            // Подготовка данных
            @:const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SumDistributionResults.Select(r => r.SumHit)));
            @:const frequencies = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SumDistributionResults.Select(r => r.Frequency)));
            @:const probabilities = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SumDistributionResults.Select(r => r.Probability)));

            @:const tabButton = document.querySelector('[data-bs-target="#chartTab"]');
            @:const canvasId = 'sumDistributionChart';

            @:if (tabButton) {
            @:    tabButton.addEventListener('shown.bs.tab', function() {
            @:        const ctx = document.getElementById(canvasId)?.getContext('2d');
            @:
            @:        // Инициализируем график только один раз
            @:        if (ctx && !sumChartInstance) {
            @:            sumChartInstance = new Chart(ctx, {
            @:                type: 'line',
            @:                // ИСПРАВЛЕНО: Убран лишний объект {}
            @:                data: {
            @:                    labels: labels,
            @:                    datasets: [{
            @:                        label: 'Частота',
            @:                        data: frequencies, // ИСПРАВЛЕНО: data: frequencies
            @:                        borderColor: 'rgba(54, 162, 235, 1)',
            @:                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
            @:                        pointBackgroundColor: 'rgb(54, 162, 235)',
            @:                        borderWidth: 2,
            @:                        fill: true,
            @:                        tension: 0.4
            @:                    }]
            @:                },
            @:                options: {
            @:                    responsive: true,
            @:                    maintainAspectRatio: false, // Чтобы график влез в div 500px
            @:                    scales: {
            @:                        y: { beginAtZero: true, title: { display: true, text: 'Частота' } },
            @:                        x: { title: { display: true, text: 'Сумма выпавших чисел' } }
            @:                    },
            @:                    plugins: {
            @:                        tooltip: {
            @:                            callbacks: {
            @:                                title: function(context) {
            @:                                    return `Сумма: ${context[0].label}`;
            @:                                },
            @:                                label: function(context) {
            @:                                    const freq = context.raw;
            @:                                    const prob = probabilities[context.dataIndex];
            @:                                    return [`Частота: ${freq}`, `Шанс: ${prob}%`];
            @:                                }
            @:                            }
            @:                        },
            @:                        legend: { display: false }
            @:                    }
            @:                }
            @:            });
            @:        }
            @:    });
            @:}

            @:window.downloadChart = function() {
            @:    if (sumChartInstance) {
            @:        const link = document.createElement('a');
            @:        link.href = sumChartInstance.toBase64Image({ backgroundColor: 'white' }); // Добавил белый фон
            @:        link.download = 'A313_sum_distribution.png';
            @:        link.click();
            @:    } else {
            @:        alert("График еще не создан. Пожалуйста, откройте вкладку 'График' сначала.");
            @:    }
            @:};
    }
</script>