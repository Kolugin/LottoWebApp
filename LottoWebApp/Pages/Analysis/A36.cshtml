@page
@model LottoWebApp.Pages.Analysis.A36Model
@{
    ViewData["Title"] = "3.6 Карта распределения четности и нечетности";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" class="mb-4">
        <input type="hidden" name="Game" value="@Model.Game" />
        <div class="row">
            <div class="col-md-4">
                <label for="DrawCount" class="form-label">Количество тиражей (0 - все)</label>
                <input type="number" name="DrawCount" id="DrawCount" class="form-control" min="0" value="@(Model.DrawCount > 0 ? Model.DrawCount : 0)" />
            </div>
            <div class="col-md-4">
                <label for="Direction" class="form-label">Направление</label>
                <select name="Direction" id="Direction" class="form-select">
                    <option value="newToOld" selected="@(Model.Direction == "newToOld")">Сначала новые</option>
                    <option value="oldToNew" selected="@(Model.Direction == "oldToNew")">Сначала старые</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Построить карту распределения</button>
                @if (Model.DistributionResults != null)
                {
                    <button type="submit" asp-page-handler="DownloadCsv" class="btn btn-success w-100 mt-2">💾 Скачать CSV</button>
                }
            </div>
        </div>
    </form>

    <ul class="nav nav-tabs">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tableTab">📋 Таблица</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chartTab">📊 График</button>
        </li>
    </ul>

    <div class="tab-content mt-3">
        <div class="tab-pane fade show active" id="tableTab">
            @if (Model.DistributionResults != null)
            {
                <div class="table-responsive">
                    <table class="table table-dark table-bordered text-center">
                        <thead>
                            <tr>
                                <th>Кол-во четных</th>
                                <th>Кол-во нечетных</th>
                                <th>Всего выпало</th>
                                <th>Шанс (%)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.DistributionResults)
                            {
                                <tr>
                                    <td>@r.EvenCount</td>
                                    <td>@r.OddCount</td>
                                    <td>@r.TotalCount</td>
                                    <td>@r.Chance</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="chartTab">
            @if (Model.DistributionResults != null)
            {
                <canvas id="distributionChart" height="120"></canvas>
                <button class="btn btn-info mt-2" onclick="downloadChart()">📥 Скачать график (PNG)</button>
            }
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    @if (Model.DistributionResults != null)
    {
            @:const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.DistributionResults.Select(r => r.EvenCount + " четных / " + r.OddCount + " нечетных")
                ));
                @:const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.DistributionResults.Select(r => r.TotalCount)
                ));
                @:const chances = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.DistributionResults.Select(r => r.Chance)
                ));

                @:const ctx = document.getElementById('distributionChart').getContext('2d');
            @:const chartRef = new Chart(ctx, {
            @:    type: 'bar',
            @:    data: {
            @:        labels: labels,
            @:        datasets: [{
            @:            label: 'Количество выпадений',
            @:            data: values,
            @:            backgroundColor: 'rgba(54, 162, 235, 0.8)',
            @:            borderWidth: 1
            @:        }]
            @:    },
            @:    options: {
            @:        responsive: true,
            @:        scales: { y: { beginAtZero: true } },
            @:        plugins: {
            @:            tooltip: {
            @:                callbacks: {
            @:                    label: function(context) {
            @:                        return `Шанс: ${chances[context.dataIndex]}%`;
            @:                    }
            @:                }
            @:            }
            @:        }
            @:    }
            @:});

            @:function downloadChart() {
            @:    const link = document.createElement('a');
            @:    link.href = chartRef.toBase64Image();
            @:    link.download = 'A36_even_odd_distribution.png';
            @:    link.click();
            @:}
    }
</script>
