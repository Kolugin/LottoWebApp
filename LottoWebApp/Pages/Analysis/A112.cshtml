@page
@model LottoWebApp.Pages.Analysis.A112Model
@{
    ViewData["Title"] = "1.12 Вывод частоты и шанса выпадения дополнительного шара";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <!-- Кнопки экспорта -->
    <form method="post" asp-page-handler="DownloadCsv" class="d-inline-block">
        <input type="hidden" name="Game" value="@Model.Game" />
        <input type="hidden" name="DrawCount" value="@Model.DrawCount" />
        <input type="hidden" name="Direction" value="@Model.Direction" />
        <input type="hidden" name="Title" value="@ViewData["Title"]" />
        <button class="btn btn-success mb-4">💾 Скачать таблицу (CSV)</button>
    </form>

    <button class="btn btn-info mb-4 ms-2" onclick="downloadChart()">📥 Скачать график (PNG)</button>

    <ul class="nav nav-tabs">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tableTab">📋 Таблица</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#chartTab">📊 График</button></li>
    </ul>

    <div class="tab-content mt-3">

        <!-- Таблица -->
        <div class="tab-pane fade show active" id="tableTab">
            <table class="table table-dark table-bordered text-center">
                <thead>
                    <tr>
                        <th>№ Шара</th>
                        <th>Кол-во выпадений</th>
                        <th>Шанс (%)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Results)
                    {
                        <tr>
                            <td>@r.Number</td>
                            <td>@r.Count</td>
                            <td>@r.Chance</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- График -->
        <div class="tab-pane fade" id="chartTab">
            <canvas id="chartFreq" height="120"></canvas>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script>
    // Подготовка данных
    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Results.Select(r => r.Number)));
    const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Results.Select(r => r.Count)));

    const colors = values.map(() => 'rgba(54, 162, 235, 0.8)');

    const ctx = document.getElementById('chartFreq').getContext('2d');

    const chartRef = new Chart(ctx, {
        type: 'bar',
        data: { 
            labels: labels,
            datasets: [{
                label: 'Количество выпадений',
                data: values,
                backgroundColor: colors,
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { beginAtZero: true }
            },
            plugins: {
                zoom: {
                    pan: {
                        enabled: true,
                        mode: 'x',
                        modifierKey: 'ctrl'
                    },
                    zoom: {
                        wheel: { enabled: true },
                        pinch: { enabled: true },
                        mode: 'x'
                    }
                }
            }
        }
    });

    function downloadChart() {
        const a = document.createElement("a");
        a.href = chartRef.toBase64Image();
        a.download = "A112_bonus_ball_frequency.png";
        a.click();
    }
</script>
