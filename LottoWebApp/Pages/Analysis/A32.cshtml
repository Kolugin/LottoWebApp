@page
@model LottoWebApp.Pages.Analysis.A32Model
@{
    ViewData["Title"] = "3.2 Карта распределения выпадения";
    var fields = Model.Is320 ? new[] { "B1", "B2" } : new[] { "B" };
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>
    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" class="mb-4">
        <input type="hidden" name="Game" value="@Model.Game" />
        <input type="hidden" name="SelectedTable" id="selectedTableInput" value="" />
        <div class="row">
            <div class="col-md-3">
                <label for="DrawCount" class="form-label">Количество тиражей (0 - все)</label>
                <input type="number" name="DrawCount" id="DrawCount" class="form-control" min="0" value="@(Model.DrawCount > 0 ? Model.DrawCount : 0)" />
            </div>
            <div class="col-md-3">
                <label for="Direction" class="form-label">Направление</label>
                <select name="Direction" id="Direction" class="form-select">
                    <option value="newToOld" selected="@(Model.Direction == "newToOld")">Сначала новые</option>
                    <option value="oldToNew" selected="@(Model.Direction == "oldToNew")">Сначала старые</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="EnableSorting" class="form-label">Упорядоченная карта</label>
                <select name="EnableSorting" id="EnableSorting" class="form-select" @(Model.IsAlwaysUnordered ? "disabled" : "")>
                    <option value="false" selected="@(Model.EnableSorting == false)">Нет</option>
                    <option value="true" selected="@(Model.EnableSorting == true)">Да</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Построить карту</button>
                @if (Model.DistributionData != null || Model.DistributionDataByField.Any())
                {
                    <button type="submit" asp-page-handler="DownloadCsv" class="btn btn-success w-100 mt-2">💾 Скачать CSV</button>
                }
            </div>
        </div>
    </form>

    @if (Model.DistributionData != null || Model.DistributionDataByField.Any())
    {
        <ul class="nav nav-tabs">
            @foreach (var field in fields)
            {
                var distData = Model.Is320 ? Model.DistributionDataByField[field] : Model.DistributionData;

                <li class="nav-item">
                    <button class="nav-link @(field == fields[0] ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tableTab_@field">📋 Таблица @(Model.Is320? field : "")</button>
                </li>

                @for (int pos = 1; pos <= Model.NumberOfBalls; pos++)
                {
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chartTab_@field-@pos" data-field="@field" data-pos="@pos">📊 П@(pos) @(Model.Is320 ? "(" + field + ")" : "")</button>
                    </li>
                }
            }
        </ul>

        <div class="tab-content mt-3">
            @foreach (var field in fields)
            {
                var distData = Model.Is320 ? Model.DistributionDataByField[field] : Model.DistributionData;
                var isActive = field == fields[0];

                <div class="tab-pane fade @(isActive ? "show active" : "")" id="tableTab_@field">
                    <div class="table-responsive">
                        <table class="table table-dark table-bordered text-center">
                            <thead>
                                <tr>
                                    <th>Число</th>
                                    @for (int pos = 1; pos <= Model.NumberOfBalls; pos++)
                                    {
                                        <th>П@(pos)</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (int number = 1; number <= Model.MaxBallNumber; number++)
                                {
                                    <tr>
                                        <th>@number</th>
                                        @for (int pos = 0; pos < Model.NumberOfBalls; pos++)
                                        {
                                            var count = distData.TryGetValue((number, pos), out int c) ? c : 0;
                                            <td>@count</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @for (int pos = 1; pos <= Model.NumberOfBalls; pos++)
                {
                    <div class="tab-pane fade" id="chartTab_@field-@pos">
                        <canvas id="chartPos_@field-@pos" height="120"></canvas>
                        <button class="btn btn-info mt-2" onclick="downloadChart('chartPos_@field-@pos', 'A32_distribution_@(field)_pos@(pos).png')">📥 Скачать PNG</button>
                    </div>
                }
            }
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const is320 = @Model.Is320.ToString().ToLower();
    const maxBallNumber = @Model.MaxBallNumber;
    const numberOfBalls = @Model.NumberOfBalls;
    const charts = {};
    let activeCanvasId = null;

    const countsByFieldAndPos = {
        @foreach (var field in fields)
        {
                var distData = Model.Is320 ? Model.DistributionDataByField[field] : Model.DistributionData;
                <text>
                '@field': [
                    @for (int pos = 0; pos < Model.NumberOfBalls; pos++)
                    {
                            <text>
                            [
                                @for (int number = 1; number <= Model.MaxBallNumber; number++)
                                {
                                        var count = distData.TryGetValue((number, pos), out int c) ? c : 0;
                                        @:@count@(number < Model.MaxBallNumber ? "," : "")
                                }
                            ]@(pos < Model.NumberOfBalls - 1 ? "," : "")
                            </text>
                    }
                ]@(field != fields.Last() ? "," : "")
                </text>
        }
    };

    function ensureChart(field, posIndex) {
        const canvasId = 'chartPos_' + field + '-' + (posIndex + 1);
        if (charts[canvasId]) return charts[canvasId];

        const canvas = document.getElementById(canvasId);
        if (!canvas) return null;

        const counts = countsByFieldAndPos[field][posIndex];

        charts[canvasId] = new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: Array.from({ length: maxBallNumber }, (_, i) => i + 1),
                datasets: [{
                    label: 'Количество выпадений в позиции ' + (posIndex + 1) + (is320 ? ' (' + field + ')' : ''),
                    data: counts,
                    backgroundColor: 'rgba(54, 162, 235, 0.8)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true } }
            }
        });

        return charts[canvasId];
    }

    document.addEventListener('DOMContentLoaded', function() {
        const activeTab = document.querySelector('.nav-tabs .nav-link.active');
        if (activeTab) {
            const target = activeTab.getAttribute('data-bs-target');
            if (target && target.startsWith('#chartTab_')) {
                const field = activeTab.dataset.field;
                const pos = parseInt(activeTab.dataset.pos);
                ensureChart(field, pos - 1);
                activeCanvasId = 'chartPos_' + field + '-' + pos;
            }
        }

        document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(btn => {
            btn.addEventListener('shown.bs.tab', function (e) {
                const targetSelector = e.target.getAttribute('data-bs-target');
                if (targetSelector && targetSelector.startsWith('#tableTab_')) {
                    const field = targetSelector.substring(10);
                    document.getElementById("selectedTableInput").value = is320 ? field : "";
                } else if (targetSelector && targetSelector.startsWith('#chartTab_')) {
                    const field = e.target.dataset.field;
                    const pos = parseInt(e.target.dataset.pos);
                    ensureChart(field, pos - 1);
                    activeCanvasId = 'chartPos_' + field + '-' + pos;
                }
            });
        });
    });

    function downloadChart(canvasId, filename) {
        const chart = charts[canvasId];
        if (chart) {
            const link = document.createElement('a');
            link.href = chart.toBase64Image();
            link.download = filename;
            link.click();
        } else {
            alert('График не найден: ' + canvasId);
        }
    }
</script>