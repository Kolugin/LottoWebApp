@page
@model LottoWebApp.Pages.Analysis.A41Model
@{
    ViewData["Title"] = "4.1 Досье на число";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" class="mb-4">
        <div class="row">
            <div class="col-md-4">
                <label for="SelectedNumber" class="form-label">Номер шара</label>
                <input type="number" name="SelectedNumber" id="SelectedNumber" class="form-control" min="1" value="@(Model.SelectedNumber > 0 ? Model.SelectedNumber : 1)" required />
            </div>
            <div class="col-md-4">
                <label for="DrawCount" class="form-label">Количество тиражей (0 - все)</label>
                <input type="number" name="DrawCount" id="DrawCount" class="form-control" min="0" value="@(Model.DrawCount > 0 ? Model.DrawCount : 0)" />
            </div>
            <div class="col-md-4">
                <label for="Direction" class="form-label">Направление</label>
                <select name="Direction" id="Direction" class="form-select">
                    <option value="newToOld" selected="@(Model.Direction == "newToOld")">Сначала новые</option>
                    <option value="oldToNew" selected="@(Model.Direction == "oldToNew")">Сначала старые</option>
                </select>
            </div>
            <div class="col-md-12 mt-2">
                <button type="submit" class="btn btn-primary">Получить статистику</button>
            </div>
        </div>
    </form>

    @if (Model.Statistics != null)
    {
        <div class="row">
            <div class="col-12">
                <form method="post" asp-page-handler="DownloadCsv">
                    <input type="hidden" name="Game" value="@Model.Game" />
                    <input type="hidden" name="SelectedNumber" value="@Model.SelectedNumber" />
                    <input type="hidden" name="DrawCount" value="@Model.DrawCount" />
                    <input type="hidden" name="Direction" value="@Model.Direction" />
                    <button type="submit" class="btn btn-success mb-3">💾 Скачать CSV</button>
                </form>

                <h4>Статистика для шара №@Model.Statistics.Number</h4>
                <p>Выпал @Model.Statistics.Occurrences раз(а)</p>
                <p>Последний раз выпал: @Model.Statistics.LastOccurrenceDate</p>
                <p>Общий шанс выпадения в %: @Model.Statistics.ProbabilityOverall.ToString("F4")%</p>

                <h5>Даты выпадения:</h5>
                <table class="table table-dark table-bordered">
                    <thead>
                        <tr>
                            @if (Model.HasTime)
                            {
                                <th>Дата</th>
                                <th>Время</th>
                            }
                            else
                            {
                                <th>Дата</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dateEntry in Model.Statistics.DateEntries)
                        {
                            <tr>
                                @if (Model.HasTime)
                                {
                                    <td>@dateEntry.Date</td>
                                    <td>@dateEntry.Time</td>
                                }
                                else
                                {
                                    <td>@dateEntry.Date</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>