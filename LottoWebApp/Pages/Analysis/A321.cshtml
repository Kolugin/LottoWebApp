@page
@model LottoWebApp.Pages.Analysis.A321Model
@{
    ViewData["Title"] = "3.21 Карта переходов выпадения комбинации на каждый тираж";
    var disableSort = Model.Game?.ToLower() == "1224" || Model.Game?.ToLower() == "blitz";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" class="mb-4">
        <input type="hidden" name="Game" value="@Model.Game" />
        <div class="row g-3 align-items-end">

            <div class="col-md-3">
                <label for="DrawCount" class="form-label">Количество тиражей (0 - все)</label>
                <input type="number" name="DrawCount" id="DrawCount" class="form-control" min="0" value="@(Model.DrawCount > 0 ? Model.DrawCount : 0)" />
            </div>

            <div class="col-md-3">
                <label for="Direction" class="form-label">Направление</label>
                <select name="Direction" id="Direction" class="form-select">
                    <option value="newToOld" selected="@(Model.Direction == "newToOld")">Сначала новые</option>
                    <option value="oldToNew" selected="@(Model.Direction == "oldToOld")">Сначала старые</option>
                </select>
            </div>

            @if (!disableSort)
            {
                <div class="col-md-3">
                    <label for="SortBalls" class="form-label">Упорядочивание шаров</label>
                    <select name="SortBalls" id="SortBalls" class="form-select">
                        <option value="false" selected="@(!Model.SortBalls)">По позиции (B1, B2, ...)</option>
                        <option value="true" selected="@(Model.SortBalls)">По значению шара (Сортировка)</option>
                    </select>
                </div>
            }
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Построить карту переходов</button>
                @if (Model.TransitionResults.Any())
                {
                    <button type="submit" asp-page-handler="DownloadCsv" class="btn btn-success w-100 mt-2">💾 Скачать CSV</button>
                }
            </div>

            @if (disableSort)
            {
                <input type="hidden" name="SortBalls" value="false" />
            }
        </div>
    </form>

    @if (Model.TransitionResults.Any())
    {
        <h3>📋 Результаты переходов (Тираж -> Переход по позиции)</h3>

        <div class="table-responsive">
            <table class="table table-dark table-bordered text-center align-middle">
                <thead>
                    <tr>
                        <th rowspan="2">Тираж</th>
                        <th rowspan="2">Дата</th>
                        @if (Model.HasTime)
                        {
                            <th rowspan="2">Время</th>
                        }
                        <th colspan="@Model.NumberOfBalls">Переходы (Пред. Шар -> Тек. Шар) по позиции</th>
                    </tr>
                    <tr>
                        @for (int i = 1; i <= Model.NumberOfBalls; i++)
                        {
                            <th>Позиция @i</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{
                        var groupedByDraw = Model.TransitionResults
                        .GroupBy(r => r.DrawNumber)
                        .OrderBy(g => g.Key)
                        .ToList();
                    }

                    @foreach (var drawGroup in groupedByDraw)
                    {
                        var results = drawGroup.OrderBy(r => r.Position).ToList();

                        <tr>
                            <td>@drawGroup.Key</td>
                            <td>@(results.FirstOrDefault()?.DrawDate)</td>
                            @if (Model.HasTime)
                            {
                                <td>@(results.FirstOrDefault()?.DrawTime)</td>
                            }
                            @foreach (var result in results)
                            {
                                <td>@result.Transition</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>