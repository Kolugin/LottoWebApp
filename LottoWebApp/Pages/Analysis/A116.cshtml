@page
@model LottoWebApp.Pages.Analysis.A116Model
@{
    ViewData["Title"] = "1.16 Вывод частоты и шанса выпадения дополнительного шара по году";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <!-- Кнопки экспорта -->
    <form method="post" asp-page-handler="DownloadCsv" class="d-inline-block">
        <input type="hidden" name="Game" value="@Model.Game" />
        <input type="hidden" name="DrawCount" value="@Model.DrawCount" />
        <input type="hidden" name="Direction" value="@Model.Direction" />
        <input type="hidden" name="Title" value="@ViewData["Title"]" />
        <button class="btn btn-success mb-4">💾 Скачать таблицу (CSV)</button>
    </form>

    <button class="btn btn-info mb-4 ms-2" onclick="downloadChart()">📥 Скачать график (PNG)</button>

    <ul class="nav nav-tabs">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tableTab">📋 Таблица</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#chartTab">📊 График</button></li>
        @foreach (var year in Model.Results.Select(r => r.Year).Distinct().OrderBy(y => y))
        {
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chartTab@(year)">Год @year</button>
            </li>
        }
    </ul>

    <div class="tab-content mt-3">

        <!-- Таблица -->
        <div class="tab-pane fade show active" id="tableTab">
            <table class="table table-dark table-bordered text-center">
                <thead>
                    <tr>
                        <th>Год</th>
                        <th>№ Шара</th>
                        <th>Кол-во выпадений</th>
                        <th>Шанс (%)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Results)
                    {
                        <tr>
                            <td>@r.Year</td>
                            <td>@r.Number</td>
                            <td>@r.Count</td>
                            <td>@r.Chance</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Общий график -->
        <div class="tab-pane fade" id="chartTab">
            <canvas id="chartFreq" height="120"></canvas>
        </div>

        <!-- Графики по годам -->
        @foreach (var year in Model.Results.Select(r => r.Year).Distinct().OrderBy(y => y))
        {
            <div class="tab-pane fade" id="chartTab@(year)">
                <canvas id="chartFreq@(year)" height="120"></canvas>
            </div>
        }

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Общий график
    const allLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Results.Select(r => r.Year + " - " + r.Number)));
    const allValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Results.Select(r => r.Count)));
    const allColors = allValues.map(() => 'rgba(54, 162, 235, 0.8)');

    const chartRef = new Chart(document.getElementById('chartFreq'), {
        type: 'bar',
        data: {
            labels: allLabels,
            datasets: [{
                label: 'Количество выпадений',
                data: allValues,
                backgroundColor: allColors,
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: { y: { beginAtZero: true } }
        }
    });

    // Словарь для всех графиков
    const charts = {};
    charts["chartFreq"] = chartRef;

    // Графики по годам
    @foreach (var year in Model.Results.Select(r => r.Year).Distinct().OrderBy(y => y))
    {
            var list = Model.Results.Where(r => r.Year == year)
                                                            .Select(r => new { r.Number, r.Count })
                                                            .ToList();
            <text>
            const data@(year) = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(list));
            if (data@(year).length > 0) {
                const labels@(year) = data@(year).map(x => x.Number.toString());
                const values@(year) = data@(year).map(x => x.Count);
                const colors@(year) = values@(year).map(() => 'rgba(54, 162, 235, 0.8)');

                charts["chartFreq@(year)"] = new Chart(document.getElementById("chartFreq@(year)"), {
                    type: 'bar',
                    data: {
                        labels: labels@(year),
                        datasets: [{
                            label: 'Количество выпадений',
                            data: values@(year),
                            backgroundColor: colors@(year),
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: { y: { beginAtZero: true } }
                    }
                });
            }
            </text>
    }

    let activeCanvasId = null;

    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(btn => {
            btn.addEventListener('shown.bs.tab', function (e) {
                const target = e.target.getAttribute('data-bs-target');

                if (target === '#chartTab') activeCanvasId = 'chartFreq';
                else if (target.startsWith('#chartTab')) activeCanvasId = 'chartFreq' + target.replace('#chartTab', '');
            });
        });
    });

    function downloadChart() {
        const chart = charts[activeCanvasId];
        if (!chart) {
            alert('Открой вкладку с нужным графиком перед экспортом.');
            return;
        }

        const a = document.createElement("a");
        a.href = chart.toBase64Image();
        a.download = activeCanvasId + ".png";
        a.click();
    }
</script>

