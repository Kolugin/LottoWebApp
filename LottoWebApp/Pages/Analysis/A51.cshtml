@page
@model LottoWebApp.Pages.Analysis.A51Model
@{
    ViewData["Title"] = "5.1 Таблицы переходов из числа в число";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" class="mb-4">
        <input type="hidden" name="Game" value="@Model.Game" />
        <input type="hidden" id="selectedPositionInput" name="SelectedPosition" value="-1" />
        <div class="row">
            <div class="col-md-4">
                <label for="DrawCount" class="form-label">Количество тиражей (0 - все)</label>
                <input type="number" name="DrawCount" id="DrawCount" class="form-control" min="0" value="@(Model.DrawCount > 0 ? Model.DrawCount : 0)" />
            </div>
            <div class="col-md-4">
                <label for="Direction" class="form-label">Направление</label>
                <select name="Direction" id="Direction" class="form-select">
                    <option value="newToOld" selected="@(Model.Direction == "newToOld")">Сначала новые</option>
                    <option value="oldToNew" selected="@(Model.Direction == "oldToNew")">Сначала старые</option>
                </select>
            </div>
            <div class="col-md-4">
                <label for="SortBalls" class="form-label">Сортировать числа</label>
                <select name="SortBalls" id="SortBalls" class="form-select">
                    <option value="false" selected="@(Model.SortBalls == false)">Нет</option>
                    <option value="true" selected="@(Model.SortBalls == true)">Да</option>
                </select>
            </div>
            <div class="col-md-12 mt-2">
                <button type="submit" class="btn btn-primary">Рассчитать таблицы переходов</button>
                @if (Model.TransitionMatrixByPosition != null)
                {
                    <button type="submit" asp-page-handler="DownloadCsv" class="btn btn-success ms-2">💾 Скачать CSV</button>
                }
            </div>
        </div>
    </form>

    @if (Model.TransitionMatrixByPosition != null)
    {
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#generalTab">Общая таблица</button>
            </li>
            @for (int pos = 0; pos < Model.NumberOfBalls; pos++)
            {
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#position@(pos + 1)Tab">Позиция @(pos + 1)</button>
                </li>
            }
        </ul>

        <div class="tab-content mt-3">
            <div class="tab-pane fade show active" id="generalTab">
                <h3>Общая таблица переходов</h3>
                <div class="table-responsive">
                    <table class="table table-dark table-bordered">
                        <thead>
                            <tr>
                                <th>Из \ В</th>
                                @for (int j = 1; j <= Model.MaxBallNumber; j++)
                                {
                                    <th>@j</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 1; i <= Model.MaxBallNumber; i++)
                            {
                                <tr>
                                    <th>@i</th>
                                    @for (int j = 1; j <= Model.MaxBallNumber; j++)
                                    {
                                        var count = Model.GeneralTransitionMatrix.TryGetValue((i, j), out var c) ? c : 0;
                                        // Расчет шанса перехода
                                        double chance = 0;
                                        int totalFromI = 0;
                                        for (int k = 1; k <= Model.MaxBallNumber; k++)
                                        {
                                            totalFromI += Model.GeneralTransitionMatrix.TryGetValue((i, k), out var val) ? val : 0;
                                        }
                                        if (totalFromI > 0)
                                        {
                                            chance = (double)count / totalFromI;
                                        }
                                        <td>@(chance > 0 ? (chance * 100).ToString("F4") + "%" : "-")</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @for (int pos = 0; pos < Model.NumberOfBalls; pos++)
            {
                <div class="tab-pane fade" id="position@(pos + 1)Tab">
                    <h3>Таблица переходов для позиции @(pos + 1)</h3>
                    <div class="table-responsive">
                        <table class="table table-dark table-bordered">
                            <thead>
                                <tr>
                                    <th>Из \ В</th>
                                    @for (int j = 1; j <= Model.MaxBallNumber; j++)
                                    {
                                        <th>@j</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 1; i <= Model.MaxBallNumber; i++)
                                {
                                    <tr>
                                        <th>@i</th>
                                        @for (int j = 1; j <= Model.MaxBallNumber; j++)
                                        {
                                            var count = Model.PositionTransitionMatrices[pos].TryGetValue((i, j), out var c) ? c : 0;
                                            // Расчет шанса перехода
                                            double chance = 0;
                                            int totalFromI = 0;
                                            for (int k = 1; k <= Model.MaxBallNumber; k++)
                                            {
                                                totalFromI += Model.PositionTransitionMatrices[pos].TryGetValue((i, k), out var val) ? val : 0;
                                            }
                                            if (totalFromI > 0)
                                            {
                                                chance = (double)count / totalFromI;
                                            }
                                            <td>@(chance > 0 ? (chance * 100).ToString("F4") + "%" : "-")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Находим все кнопки переключения табов
            var triggerTabList = [].slice.call(document.querySelectorAll('.nav-link'));
            var input = document.getElementById('selectedPositionInput');

            triggerTabList.forEach(function (triggerEl) {
                triggerEl.addEventListener('shown.bs.tab', function (event) {
                    // event.target - это активная вкладка
                    var targetId = event.target.getAttribute('data-bs-target'); // например #generalTab или #position1Tab

                    if (targetId === '#generalTab') {
                        input.value = "-1"; // Общая таблица
                    } else {
                        // Извлекаем номер из строки #position1Tab, #position2Tab...
                        // Нам нужен индекс массива (0, 1, 2...), поэтому вычитаем 1
                        var posIndex = parseInt(targetId.replace('#position', '').replace('Tab', '')) - 1;
                        input.value = posIndex;
                    }
                    console.log("Selected tab position index: " + input.value);
                });
            });
        });
    </script>
}