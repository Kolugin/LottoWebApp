@page
@using System.Globalization
@model LottoWebApp.Pages.Analysis.A37Model
@{
    ViewData["Title"] = "3.7 Карта распределения частоты";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" class="mb-4">
        <input type="hidden" name="Game" value="@Model.Game" />
        <div class="row">
            <div class="col-md-4">
                <label for="DrawCount" class="form-label">Количество тиражей (0 - все)</label>
                <input type="number" name="DrawCount" id="DrawCount" class="form-control" min="0" value="@(Model.DrawCount > 0 ? Model.DrawCount : 0)" />
            </div>
            <div class="col-md-4">
                <label for="Direction" class="form-label">Направление</label>
                <select name="Direction" id="Direction" class="form-select">
                    <option value="newToOld" selected="@(Model.Direction == "newToOld")">Сначала новые</option>
                    <option value="oldToNew" selected="@(Model.Direction == "oldToNew")">Сначала старые</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Построить карту распределения</button>
                @if (Model.IntervalTables.Any())
                {
                    <button type="submit" asp-page-handler="DownloadCsv" class="btn btn-success w-100 mt-2">💾 Скачать CSV (ZIP)</button>
                }
            </div>
        </div>
    </form>

    @if (Model.IntervalTables.Any())
    {
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#table10">📋 10 тиражей</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#table50">📋 50 тиражей</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#table100">📋 100 тиражей</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chart10">📊 График 10</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chart50">📊 График 50</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chart100">📊 График 100</button>
            </li>
        </ul>

        <div class="tab-content mt-3">
            @foreach (var interval in new[] { 10, 50, 100 })
            {
                <div class="tab-pane fade @(interval == 10 ? "show active" : "")" id="table@(interval)">
                    <h3>Карта распределения частоты за @interval тиражей</h3>
                    @if (Model.IntervalTables.ContainsKey(interval))
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-bordered text-center">
                                <thead>
                                    <tr>
                                        <th>№ Тиражей</th>
                                        @for (int i = 1; i <= Model.NumberOfBalls; i++)
                                        {
                                            <th>№Поз @i</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.IntervalTables[interval])
                                    {
                                        <tr>
                                            <td>@row.TicketRange</td>
                                            @for (int i = 1; i <= Model.NumberOfBalls; i++)
                                            {
                                                var prob = row.Positions.TryGetValue(i, out var p) ? p : "-";
                                                <td class="@(Model.GetColorClassForValue(p, i))">@prob</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }

            @foreach (var interval in new[] { 10, 50, 100 })
            {
                <div class="tab-pane fade" id="chart@(interval)">
                    @if (Model.IntervalTables.ContainsKey(interval))
                    {
                        <h3>График распределения частоты за @interval тиражей</h3>
                        <canvas id="chart@(interval)Canvas" height="120"></canvas>
                    }
                </div>
            }
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    @foreach (var interval in new[] { 10, 50, 100 })
    {
            if (Model.IntervalTables.ContainsKey(interval))
            {
                    var allValues = Model.IntervalTables[interval]
                            .SelectMany(r => r.Positions.Values)
                            .Where(v => !string.IsNullOrEmpty(v) && v != "-") // Исключаем прочерки
                            .Select(v =>
                            {
                                    double val;
                                    return double.TryParse(v, NumberStyles.Any, CultureInfo.InvariantCulture, out val)
                                            ? Math.Round(val, 2)
                                            : (double?)null;
                            })
                            .Where(v => v.HasValue)
                            .Select(v => v.Value)
                            .ToList();

                    var frequencyGroups = allValues
                            .GroupBy(v => v)
                            .OrderBy(g => g.Key)
                            .ToDictionary(g => g.Key, g => g.Count());

                    var freqLabels = System.Text.Json.JsonSerializer.Serialize(
                            frequencyGroups.Keys.Select(k => k.ToString("0.##", CultureInfo.InvariantCulture))
                    );
                    var freqCounts = System.Text.Json.JsonSerializer.Serialize(frequencyGroups.Values);

                    var colors = interval switch
                    {
                            10 => "rgba(255, 99, 132, 0.8)",
                            50 => "rgba(54, 162, 235, 0.8)",
                            100 => "rgba(75, 192, 192, 0.8)",
                            _ => "rgba(54, 162, 235, 0.8)"
                    };

                    <text>
                    (function() {
                        const labels = @Html.Raw(freqLabels);
                        const counts = @Html.Raw(freqCounts);
                        const ctx = document.getElementById('chart@(interval)Canvas');
                        if (ctx) {
                            new Chart(ctx, {
                                type: 'bar',
                                data: {
                                    labels: labels,
                                    datasets: [{
                                        label: 'Количество совпадений периода (@interval тиражей)',
                                        data: counts,
                                        backgroundColor: '@colors',
                                        borderWidth: 1
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    scales: {
                                        y: { beginAtZero: true, title: { display: true, text: 'Количество позиций' } },
                                        x: { title: { display: true, text: 'Период выпадения (тиражей)' } }
                                    }
                                }
                            });
                        }
                    })();
                    </text>
            }
    }
</script>

<style>
    .green-cell {
        background-color: #28a745;
        color: white;
    }

    .yellow-cell {
        background-color: #ffc107;
        color: black;
    }

    .red-cell {
        background-color: #dc3545;
        color: white;
    }

    .table-secondary {
        background-color: #6c757d;
        color: white;
    }
</style>