@page
@model LottoWebApp.Pages.Analysis.A53Model
@{
    ViewData["Title"] = "5.3 Таблицы переходов № шара на другие № через интервалы";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" class="mb-4">
        <input type="hidden" name="Game" value="@Model.Game" />
        <input type="hidden" id="SelectedBall" name="SelectedBall" value="@Model.SelectedBall" />
        <div class="row">
            <div class="col-md-4">
                <label for="DrawCount" class="form-label">Количество тиражей (0 - все)</label>
                <input type="number" name="DrawCount" id="DrawCount" class="form-control" min="0" value="@(Model.DrawCount > 0 ? Model.DrawCount : 0)" />
            </div>
            <div class="col-md-4">
                <label for="Direction" class="form-label">Направление</label>
                <select name="Direction" id="Direction" class="form-select">
                    <option value="newToOld" selected="@(Model.Direction == "newToOld")">Сначала новые</option>
                    <option value="oldToNew" selected="@(Model.Direction == "oldToNew")">Сначала старые</option>
                </select>
            </div>
            <div class="col-md-4">
                <label>&nbsp;</label>
                <div>
                    <button type="submit" class="btn btn-primary">Рассчитать таблицы</button>
                    @if (Model.TransitionCountByNumber != null)
                    {
                        <button type="submit" asp-page-handler="DownloadCsv" class="btn btn-success ms-2">💾 Скачать CSV</button>
                    }
                </div>
            </div>
        </div>
    </form>

    @if (Model.TransitionCountByNumber != null)
    {
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#summaryTab">Обзор</button>
            </li>
            @for (int y = 1; y <= Model.NumberOfBalls; y++)
            {
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab@(y)">Шар @(y)</button>
                </li>
            }
        </ul>

        <div class="tab-content mt-3">
            <div class="tab-pane fade show active" id="summaryTab">
                <h3>Обзор таблиц переходов</h3>
                <p>Доступны таблицы для каждого шара от 1 до @Model.NumberOfBalls.</p>
            </div>

            @for (int y = 1; y <= Model.NumberOfBalls; y++)
            {
                <div class="tab-pane fade" id="tab@(y)">
                    <h3>Вероятности переходов для числа Y = @(y)</h3>
                    <div class="table-responsive">
                        <table class="table table-dark table-bordered">
                            <thead>
                                <tr>
                                    <th>Число Z</th>
                                    @for (int interval = 1; interval <= 10; interval++)
                                    {
                                        @for (int pos = 1; pos <= Model.MaxColumn; pos++)
                                        {
                                            <th>И @interval П @pos</th>
                                        }
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (int z = 1; z <= Model.NumberOfBalls; z++)
                                {
                                    <tr>
                                        <th>@z</th>
                                        @for (int interval = 0; interval < 10; interval++)
                                        {
                                            @for (int pos = 0; pos < Model.MaxColumn; pos++)
                                            {
                                                var count = Model.TransitionCountByNumber[y][z][interval, pos];
                                                // Расчет шанса перехода
                                                double chance = 0;
                                                int total = 0;
                                                for (int i = 0; i < 10; i++)
                                                {
                                                    for (int j = 0; j < Model.MaxColumn; j++)
                                                    {
                                                        total += Model.TransitionCountByNumber[y][z][i, j];
                                                    }
                                                }
                                                if (total > 0)
                                                {
                                                    chance = (double)count / total;
                                                }
                                                <td>@(chance > 0 ? (chance * 100).ToString("F4") + "%" : "-")</td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var tabEls = document.querySelectorAll('button[data-bs-toggle="tab"]');
            tabEls.forEach(function (tabEl) {
                tabEl.addEventListener('shown.bs.tab', function (event) {
                    var targetId = event.target.getAttribute('data-bs-target');

                    // Если ID формата #tab5, извлекаем "5"
                    if (targetId && targetId.startsWith('#tab')) {
                        var ballNumber = targetId.replace('#tab', '');
                        document.getElementById('SelectedBall').value = ballNumber;
                        console.log("Выбран шар №:", ballNumber);
                    } else {
                        // Если "Обзор", ставим 1 по умолчанию
                        document.getElementById('SelectedBall').value = 1;
                    }
                });
            });
        });
    </script>
}