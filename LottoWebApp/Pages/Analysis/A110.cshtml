@page
@model LottoWebApp.Pages.Analysis.A110Model
@{
    ViewData["Title"] = "1.10 Вывод 10 частых и редких чисел по месяцу, дню месяца и недели";
    bool is320 = Model.Game == "320";
    var fields = is320 ? new[] { "B1", "B2" } : new[] { "B" };
    var monthsOrder = new[] { "январь", "февраль", "март", "апрель", "май", "июнь", "июль", "август", "сентябрь", "октябрь", "ноябрь", "декабрь" };
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>
    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" asp-page-handler="DownloadCsv" class="d-inline-block">
        <input type="hidden" name="Game" value="@Model.Game" />
        <input type="hidden" name="DrawCount" value="@Model.DrawCount" />
        <input type="hidden" name="Direction" value="@Model.Direction" />
        <input type="hidden" name="Title" value="@ViewData["Title"]" />
        <input type="hidden" name="SelectedTable" id="selectedTableInput" value="" />
        <button class="btn btn-success mb-4">💾 Скачать таблицу (CSV)</button>
    </form>

    <button class="btn btn-info mb-4 ms-2" onclick="downloadChart()">📥 Скачать график (PNG)</button>

    <ul class="nav nav-tabs">
        @foreach (var field in fields)
        {
            var groupedData = Model.GroupedByField.ContainsKey(field) ? Model.GroupedByField[field] : new Dictionary<string, List<A110Model.FrequencyByMonthDayWeekResult>>(StringComparer.OrdinalIgnoreCase);

            <li class="nav-item">
                <button class="nav-link @(field == fields[0] ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tableTab_@field">📋 Таблица @(is320 ? field : "")</button>
            </li>

            @foreach (var month in monthsOrder)
            {
                if (groupedData.ContainsKey(month))
                {
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chartTab_@month@(is320 ? "_" + field : "")" data-month="@month" data-field="@field">@month @(is320 ? "(" + field + ")" : "")</button>
                    </li>
                }
            }
        }
    </ul>

    <div class="tab-content mt-3">
        @foreach (var field in fields)
        {
            var fieldResults = is320 ? Model.ResultsByField[field] : Model.Results;
            var groupedData = Model.GroupedByField.ContainsKey(field) ? Model.GroupedByField[field] : new Dictionary<string, List<A110Model.FrequencyByMonthDayWeekResult>>(StringComparer.OrdinalIgnoreCase);

            <div class="tab-pane fade @(field == fields[0] ? "show active" : "")" id="tableTab_@field">
                <table class="table table-dark table-bordered text-center">
                    <thead>
                        <tr>
                            <th>Месяц</th>
                            <th>День месяца</th>
                            <th>День недели</th>
                            <th>Число</th>
                            <th>Кол-во выпадений</th>
                            <th>Шанс (%)</th>
                            <th>Тип</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in fieldResults)
                        {
                            <tr>
                                <td>@r.Month</td>
                                <td>@r.DayOfMonth</td>
                                <td>@r.DayOfWeek</td>
                                <td>@r.Number</td>
                                <td>@r.Count</td>
                                <td>@r.Chance</td>
                                <td>@r.Type</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @foreach (var month in monthsOrder)
            {
                if (groupedData.ContainsKey(month))
                {
                    <div class="tab-pane fade" id="chartTab_@month@(is320 ? "_" + field : "")">
                        <canvas id="chartFreq_@month@(is320 ? "_" + field : "")" height="500"></canvas>
                    </div>
                }
            }
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1/dist/chartjs-plugin-zoom.min.js"></script>

<script>
    const is320 = @is320.ToString().ToLower();
    const charts = {};
    let activeCanvasId = null;

    function decodeHtml(str) {
        const txt = document.createElement("textarea");
        txt.innerHTML = str;
        return txt.value.trim();
    }

    const chartData = {
        @foreach (var field in fields)
        {
            var groupedData = Model.GroupedByField.ContainsKey(field) ? Model.GroupedByField[field] : new Dictionary<string, List<A110Model.FrequencyByMonthDayWeekResult>>(StringComparer.OrdinalIgnoreCase);
            @:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(field)): @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                groupedData.ToDictionary(
                    g => g.Key,
                    g => new {
                        numbers = g.Value.Select(r => r.Number).ToList(),
                        counts = g.Value.Select(r => r.Count).ToList(),
                        types = g.Value.Select(r => r.Type).ToList()
                    }
                )
            )),
        }
    };

    function ensureChartForMonth(field, month) {
        const canvasId = 'chartFreq_' + month + (is320 ? '_' + field : '');
        if (charts[canvasId]) return charts[canvasId];

        const data = chartData[field] && chartData[field][month];
        if (!data || !data.numbers || data.numbers.length === 0) return null;

        let combined = data.numbers.map((num, i) => ({
            number: num,
            count: data.counts[i],
            type: decodeHtml(data.types[i])
        }));

        const frequent = combined.filter(x => x.type === "Частое").sort((a, b) => b.count - a.count);
        const rare = combined.filter(x => x.type === "Редкое").sort((a, b) => a.count - b.count);
        const sortedResults = [...frequent, ...rare];

        const labels = sortedResults.map(x => x.number.toString());
        const values = sortedResults.map(x => x.count);
        const colors = sortedResults.map(x =>
            x.type === "Частое" ? "rgba(255, 99, 132, 0.85)" : "rgba(54, 162, 235, 0.8)"
        );

        const canvas = document.getElementById(canvasId);
        if (!canvas) return null;

        charts[canvasId] = new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Количество выпадений',
                    data: values,
                    backgroundColor: colors,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { y: { beginAtZero: true } },
                plugins: {
                    title: { display: true, text: month + (is320 ? ' (' + field + ')' : ''), font: { size: 16 } },
                    zoom: {
                        pan: { enabled: true, mode: 'x', modifierKey: 'ctrl' },
                        zoom: { wheel: { enabled: true }, pinch: { enabled: true }, mode: 'x' }
                    }
                }
            },
            plugins: [ChartZoom]
        });

        return charts[canvasId];
    }

    document.addEventListener('DOMContentLoaded', function() {
        const activeTab = document.querySelector('.nav-tabs .nav-link.active');
        if (activeTab) {
            const target = activeTab.getAttribute('data-bs-target');
            if (target && target.startsWith('#chartTab_')) {
                const month = activeTab.dataset.month;
                const field = activeTab.dataset.field;
                if (month && field) {
                    ensureChartForMonth(field, month);
                    const canvasId = 'chartFreq_' + month + (is320 ? '_' + field : '');
                    activeCanvasId = canvasId;
                }
            }
        }

        document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(btn => {
            btn.addEventListener('shown.bs.tab', function (e) {
                const targetSelector = e.target.getAttribute('data-bs-target');
                if (targetSelector && targetSelector.startsWith('#tableTab_')) {
                    const field = targetSelector.substring(10);
                    document.getElementById("selectedTableInput").value = is320 ? field : "";
                } else if (targetSelector && targetSelector.startsWith('#chartTab_')) {
                    const month = e.target.dataset.month;
                    const field = e.target.dataset.field;
                    if (month && field) {
                        ensureChartForMonth(field, month);
                        const canvasId = 'chartFreq_' + month + (is320 ? '_' + field : '');
                        activeCanvasId = canvasId;
                    }
                } else {
                    activeCanvasId = null;
                }
            });
        });
    });

    function downloadChart() {
        if (!activeCanvasId || !charts[activeCanvasId]) {
            alert('Сначала открой вкладку с графиком.');
            return;
        }
        const chart = charts[activeCanvasId];
        const link = document.createElement("a");
        link.href = chart.toBase64Image();
        link.download = `A110_${activeCanvasId}.png`;
        document.body.appendChild(link);
        link.click();
        link.remove();
    }
</script>