@page
@model LottoWebApp.Pages.Analysis.A319Model
@using System.Text.Json;
@{
    ViewData["Title"] = "3.19 Карта распределения треугольных, квадратных и зеркальных чисел";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" class="mb-4">
        <input type="hidden" name="Game" value="@Model.Game" />
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="DrawCount" class="form-label">Количество тиражей (0 - все)</label>
                <input type="number" name="DrawCount" id="DrawCount" class="form-control" min="0" value="@(Model.DrawCount > 0 ? Model.DrawCount : 0)" />
            </div>
            <div class="col-md-4">
                <label for="Direction" class="form-label">Направление</label>
                <select name="Direction" id="Direction" class="form-select">
                    <option value="newToOld" selected="@(Model.Direction == "newToOld")">Сначала новые</option>
                    <option value="oldToNew" selected="@(Model.Direction == "oldToNew")">Сначала старые</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Построить карту распределения</button>
                @if (Model.TriSqMirResults.Any())
                {
                        <button type="submit" asp-page-handler="DownloadCsv" class="btn btn-success w-100 mt-2">💾 Скачать CSV</button>
                }
            </div>
        </div>
    </form>

    @if (Model.TriSqMirResults.Any())
    {
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tableTab">📋 Таблица</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chartTab">📊 График</button>
                </li>
            </ul>

            <div class="tab-content mt-3">
                <div class="tab-pane fade show active" id="tableTab">
                    <div class="table-responsive">
                        <table class="table table-dark table-bordered text-center">
                            <thead>
                                <tr>
                                    <th>Треугольные числа</th>
                                    <th>Квадратные числа</th>
                                    <th>Зеркальные числа</th>
                                    <th>Частота</th>
                                    <th>Шанс (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var result in Model.TriSqMirResults)
                                {
                                        <tr>
                                            <td>@result.TriangularCount</td>
                                            <td>@result.SquareCount</td>
                                            <td>@result.MirroredCount</td>
                                            <td>@result.Frequency</td>
                                            <td>@result.Chance</td>
                                        </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="chartTab">
                    <h4>График распределения частоты по треугольным, квадратным и зеркальным числам</h4>
                    <div style="height: 500px;">
                        <canvas id="triSqMirChart"></canvas>
                    </div>
                    <button class="btn btn-info mt-3" onclick="downloadChart('triSqMirChart', 'A319_tri_sq_mir_distribution.png')">📥 Скачать (PNG)</button>
                </div>
            </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const chartInstances = {};

    @if (Model.TriSqMirResults.Any())
    {
            // 1. Создаем опции для camelCase
            var jsonOptions = new System.Text.Json.JsonSerializerOptions
            {
                    PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            };

            // 2. Сериализуем данные с опциями
            @:const rawData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TriSqMirResults, jsonOptions));

            // Сортировка по Triangular, Square, Mirrored (улучшено)
            @:const sortedData = [...rawData].sort((a, b) => {
            @:    if (a.triangularCount !== b.triangularCount) return a.triangularCount - b.triangularCount;
            @:    if (a.squareCount !== b.squareCount) return a.squareCount - b.squareCount;
            @:    return a.mirroredCount - b.mirroredCount;
            @:});

            @:const labels = sortedData.map(r => `${r.triangularCount}/${r.squareCount}/${r.mirroredCount}`);
            @:const frequencies = sortedData.map(r => r.frequency);
            @:const chances = sortedData.map(r => r.chance);

            // Массивы для надежного доступа в тултипе
            @:const triangularCounts = sortedData.map(r => r.triangularCount);
            @:const squareCounts = sortedData.map(r => r.squareCount);
            @:const mirroredCounts = sortedData.map(r => r.mirroredCount);


            @:function createTriSqMirChart(canvasId) {
            @:    const ctx = document.getElementById(canvasId)?.getContext('2d');
            @:    if (!ctx || chartInstances[canvasId]) return;

            @:    chartInstances[canvasId] = new Chart(ctx, {
            @:        type: 'bar',
            @:        data: { 
            @:            labels: labels,
            @:            datasets: [{
            @:                label: 'Частота',
            @:                data: frequencies,
            @:                backgroundColor: 'rgba(54, 162, 235, 0.8)',
            @:                borderColor: 'rgba(54, 162, 235, 1)',
            @:                borderWidth: 1
            @:            }]
            @:        },
            @:        options: {
            @:            responsive: true,
            @:            maintainAspectRatio: false,
            @:            scales: {
            @:                y: { beginAtZero: true, title: { display: true, text: 'Частота' } },
            @:                x: { title: { display: true, text: 'Треугольные/Квадратные/Зеркальные' } }
            @:            },
            @:            plugins: {
            @:                tooltip: {
            @:                    callbacks: {
            @:                        title: function(context) {
            @:                            const index = context[0].dataIndex;
            @:                            const tri = triangularCounts[index] !== undefined ? triangularCounts[index] : 'N/A';
            @:                            const sq = squareCounts[index] !== undefined ? squareCounts[index] : 'N/A';
            @:                            const mir = mirroredCounts[index] !== undefined ? mirroredCounts[index] : 'N/A';
            @:                            return `Треугольные: ${tri}, Квадратные: ${sq}, Зеркальные: ${mir}`;
            @:                        },
            @:                        label: function(context) {
            @:                            const index = context.dataIndex;
            @:                            const chance = chances[index] !== undefined ? chances[index] : 'N/A';
            @:                            return `Частота: ${context.raw}, Шанс: ${chance}%`;
            @:                        }
            @:                    }
            @:                }
            @:            }
            @:        }
            @:    });
            @:}

            @:document.addEventListener("DOMContentLoaded", function() {
            @:    const chartTabButton = document.querySelector('[data-bs-target="#chartTab"]');
            @:    if (chartTabButton) {
            @:        chartTabButton.addEventListener('shown.bs.tab', function() {
            @:            createTriSqMirChart('triSqMirChart');
            @:        });
            @:    }
            @:});

            @:window.downloadChart = function(chartId, filename) {
            @:    const chart = chartInstances[chartId];
            @:    if (chart) {
            @:        const link = document.createElement('a');
            @:        link.href = chart.toBase64Image({ backgroundColor: 'white' });
            @:        link.download = filename;
            @:        link.click();
            @:    } else {
            @:        alert("График еще не создан. Пожалуйста, откройте вкладку 'График'.");
            @:    }
            @:};
    }
</script>