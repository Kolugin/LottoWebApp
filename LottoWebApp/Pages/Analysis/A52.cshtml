@page
@model LottoWebApp.Pages.Analysis.A52Model
@{
    ViewData["Title"] = "5.2 Таблицы переходов по интервалам и позициям";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" class="mb-4">
        <input type="hidden" name="Game" value="@Model.Game" />
        <input type="hidden" id="SelectedInterval" name="SelectedInterval" value="@Model.SelectedInterval" />
        <input type="hidden" id="SelectedPosition" name="SelectedPosition" value="@Model.SelectedPosition" />
        <div class="row">
            <div class="col-md-4">
                <label for="DrawCount" class="form-label">Количество тиражей (0 - все)</label>
                <input type="number" name="DrawCount" id="DrawCount" class="form-control" min="0" value="@(Model.DrawCount > 0 ? Model.DrawCount : 0)" />
            </div>
            <div class="col-md-4">
                <label for="Direction" class="form-label">Направление</label>
                <select name="Direction" id="Direction" class="form-select">
                    <option value="newToOld" selected="@(Model.Direction == "newToOld")">Сначала новые</option>
                    <option value="oldToNew" selected="@(Model.Direction == "oldToNew")">Сначала старые</option>
                </select>
            </div>
            <div class="col-md-4">
                <label>&nbsp;</label>
                <div>
                    <button type="submit" class="btn btn-primary">Рассчитать таблицы</button>
                    @if (Model.TransitionMatricesByInterval != null)
                    {
                        <button type="submit" asp-page-handler="DownloadCsv" class="btn btn-success ms-2">💾 Скачать CSV</button>
                    }
                </div>
            </div>
        </div>
    </form>

    @if (Model.TransitionMatricesByInterval != null)
    {
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#summaryTab">Обзор</button>
            </li>
            @for (int interval = 1; interval <= 10; interval++)
            {
                <li class="nav-item dropdown">
                    <button class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Интервал @interval</button>
                    <ul class="dropdown-menu">
                        @for (int pos = 0; pos < Model.MaxColumn; pos++)
                        {
                            <li><a class="dropdown-item" href="#" data-bs-toggle="tab" data-bs-target="#interval@(interval)Pos@(pos)">Позиция @(pos + 1)</a></li>
                        }
                    </ul>
                </li>
            }
        </ul>

        <div class="tab-content mt-3">
            <div class="tab-pane fade show active" id="summaryTab">
                <h3>Обзор таблиц переходов</h3>
                <p>Доступны таблицы для интервалов от 1 до 10 тиражей и для всех позиций.</p>
            </div>

            @for (int interval = 1; interval <= 10; interval++)
            {
                @for (int pos = 0; pos < Model.MaxColumn; pos++)
                {
                    <div class="tab-pane fade" id="interval@(interval)Pos@(pos)">
                        <h3>Интервал @interval, Позиция @(pos + 1)</h3>
                        <div class="table-responsive">
                            <table class="table table-dark table-bordered">
                                <thead>
                                    <tr>
                                        <th>Число</th>
                                        @for (int fPos = 0; fPos < Model.MaxColumn; fPos++)
                                        {
                                            <th>@(fPos + 1) позиция</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int number = 1; number <= Model.NumberOfBalls; number++)
                                    {
                                        <tr>
                                            <th>@number</th>
                                            @for (int fPos = 0; fPos < Model.MaxColumn; fPos++)
                                            {
                                                var count = Model.TransitionMatricesByInterval[interval][number - 1, fPos, pos];
                                                // Расчет шанса перехода
                                                double chance = 0;
                                                int total = 0;
                                                for (int j = 0; j < Model.NumberOfBalls; j++)
                                                {
                                                    total += Model.TransitionMatricesByInterval[interval][number - 1, j, pos];
                                                }
                                                if (total > 0)
                                                {
                                                    chance = (double)count / total;
                                                }
                                                <td>@(chance > 0 ? (chance * 100).ToString("F4") + "%" : "-")</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Слушаем событие переключения вкладок Bootstrap
            var tabEls = document.querySelectorAll('a[data-bs-toggle="tab"], button[data-bs-toggle="tab"]');

            tabEls.forEach(function (tabEl) {
                tabEl.addEventListener('shown.bs.tab', function (event) {
                    var targetId = event.target.getAttribute('data-bs-target'); // например "#interval2Pos3"

                    if (targetId && targetId.includes('interval')) {
                        // Извлекаем числа из id (формат: #interval{N}Pos{M})
                        var match = targetId.match(/interval(\d+)Pos(\d+)/);
                        if (match) {
                            var interval = match[1];
                            var pos = match[2];

                            // Обновляем значения в скрытых полях формы
                            document.getElementById('SelectedInterval').value = interval;
                            document.getElementById('SelectedPosition').value = pos;

                            console.log("Выбран интервал:", interval, "позиция:", parseInt(pos) + 1);
                        }
                    } else if (targetId === "#summaryTab") {
                        // Если выбрали "Обзор", можно сбросить на значения по умолчанию
                        document.getElementById('SelectedInterval').value = 1;
                        document.getElementById('SelectedPosition').value = 0;
                    }
                });
            });
        });
    </script>
}