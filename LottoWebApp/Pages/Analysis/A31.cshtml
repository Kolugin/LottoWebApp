@page
@model LottoWebApp.Pages.Analysis.A31Model
@{
    ViewData["Title"] = "3.1 Карта выпадения чисел";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" class="mb-4">
        <input type="hidden" name="Game" value="@Model.Game" />
        <div class="row">
            <div class="col-md-4">
                <label for="DrawCount" class="form-label">Количество тиражей (0 - все)</label>
                <input type="number" name="DrawCount" id="DrawCount" class="form-control" min="0" value="@(Model.DrawCount > 0 ? Model.DrawCount : 0)" />
            </div>
            <div class="col-md-4">
                <label for="Direction" class="form-label">Направление</label>
                <select name="Direction" id="Direction" class="form-select">
                    <option value="newToOld" selected="@(Model.Direction == "newToOld")">Сначала новые</option>
                    <option value="oldToNew" selected="@(Model.Direction == "oldToNew")">Сначала старые</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Построить карту</button>
                @if (Model.MapData != null)
                {
                    <button type="submit" asp-page-handler="DownloadCsv" class="btn btn-success w-100 mt-2">💾 Скачать CSV</button>
                }
            </div>
        </div>
    </form>

    @if (Model.MapData != null)
    {
        <div class="table-responsive">
            <table class="table table-dark table-bordered text-center">
                <thead>
                    <tr>
                        <th>Тираж</th>
                        <th>Дата</th>
                        @if (Model.HasTime)
                        {
                            <th>Время</th>
                        }
                        @for (int i = 1; i <= Model.MaxBallNumber; i++)
                        {
                            <th>№@i</th>
                        }
                        @if (Model.UseBonus)
                        {
                            for (int b = 1; b <= 4; b++)
                            {
                                <th>Бонус @b</th>
                            }
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.MapData)
                    {
                        <tr>
                            <td>@row.Draw</td>
                            <td>@row.Date</td>
                            @if (Model.HasTime)
                            {
                                <td>@row.Time</td>
                            }
                            @for (int i = 1; i <= Model.MaxBallNumber; i++)
                            {
                                <td class="@(row.BallNumbers.Contains(i) ? "ball-cell" : "empty-cell")">@(row.BallNumbers.Contains(i) ? i.ToString() : "*")</td>
                            }
                            @if (Model.UseBonus)
                            {
                                @for (int b = 1; b <= 4; b++)
                                {
                                    <td class="@(row.BonusNumber == b ? "bonus-cell" : "empty-cell")">@(row.BonusNumber == b ? b.ToString() : "*")</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .ball-cell {
        background-color: #28a745;
    }

    .bonus-cell {
        background-color: #ffc107;
        color: #000;
    }

    .empty-cell {
        background-color: #343a40;
    }
</style>