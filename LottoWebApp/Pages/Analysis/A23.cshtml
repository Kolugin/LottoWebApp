@page
@model LottoWebApp.Pages.Analysis.A23Model
@{
    ViewData["Title"] = "2.3 Карта пауз чисел";
    bool is320 = Model.Game == "320";
    var fields = is320 ? new[] { "B1", "B2" } : new[] { "B" };
}

<div class="container-fluid mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>
    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" asp-page-handler="DownloadCsv" class="d-inline-block">
        <input type="hidden" name="Game" value="@Model.Game" />
        <input type="hidden" name="DrawCount" value="@Model.DrawCount" />
        <input type="hidden" name="Direction" value="@Model.Direction" />
        <input type="hidden" name="Title" value="@ViewData["Title"]" />
        <input type="hidden" name="SelectedTable" id="selectedTableInput" value="" />
        <button class="btn btn-success mb-4">💾 Скачать таблицу (CSV)</button>
    </form>

    @if (is320)
    {
        <ul class="nav nav-tabs mt-3">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tableTab_B1">📋 Таблица B1</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tableTab_B2">📋 Таблица B2</button>
            </li>
        </ul>
    }

    <div class="tab-content mt-3">
        @foreach (var field in fields)
        {
            var fieldResults = is320 ? Model.ResultsByField[field] : Model.Results;
            var isActive = field == fields[0];

            <div class="tab-pane fade @(isActive ? "show active" : "")" id="tableTab_@field">
                <div class="table-responsive">
                    <table class="table table-bordered text-center pause-map-table">
                        <thead class="table-dark">
                            <tr>
                                <th>Тираж</th>
                                <th>Дата</th>
                                @if (Model.HasTime)
                                {
                                    <th>Время</th>
                                }
                                @for (int i = 1; i <= Model.TotalBalls; i++)
                                {
                                    <th>№@i</th>
                                }
                                @if (Model.HasBonus && !is320)
                                {
                                    for (int b = 1; b <= 4; b++)
                                    {
                                        <th>Бонус @b</th>
                                    }
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in fieldResults)
                            {
                                <tr>
                                    <td>@row.Draw</td>
                                    <td>@row.Date</td>
                                    @if (Model.HasTime)
                                    {
                                        <td>@row.Time</td>
                                    }
                                    @for (int i = 1; i <= Model.TotalBalls; i++)
                                    {
                                        var pause = row.BallPauses.TryGetValue(i, out int pauseValue) ? pauseValue : 0;
                                        <td class="pause-cell" data-value="@pause">@pause</td>
                                    }
                                    @if (Model.HasBonus && !is320)
                                    {
                                        for (int b = 1; b <= 4; b++)
                                        {
                                            var bonusPause = row.BonusPauses.TryGetValue(b, out int bonusPauseValue) ? bonusPauseValue : 0;
                                            <td class="bonus-pause-cell" data-value="@bonusPause">@bonusPause</td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .pause-map-table {
        width: auto;
        min-width: 100%;
        font-size: 0.8rem;
        border-collapse: collapse;
    }

        .pause-map-table th,
        .pause-map-table td {
            padding: 0.3rem 0.5rem;
            text-align: center;
            white-space: nowrap;
        }

    .table-responsive {
        overflow-x: auto;
    }
</style>

<script>
    const is320 = @is320.ToString().ToLower();

    function interpolateColor(color1, color2, factor) {
        const r = Math.round(color1.r + factor * (color2.r - color1.r));
        const g = Math.round(color1.g + factor * (color2.g - color1.g));
        const b = Math.round(color1.b + factor * (color2.b - color1.b));
        return { r, g, b };
    }

    function getColorForPause(value) {
        if (value <= 0) {
            return 'white';
        }

        let color;

        if (value <= 3) {
            const ratio = value / 3.0;
            const green = { r: 0, g: 200, b: 0 };
            const yellow = { r: 255, g: 255, b: 0 };
            color = interpolateColor(green, yellow, ratio);
        } else if (value <= 7) {
            const ratio = (value - 3) / 4.0;
            const yellow = { r: 255, g: 255, b: 0 };
            const red = { r: 255, g: 0, b: 0 };
            color = interpolateColor(yellow, red, ratio);
        } else {
            color = { r: 255, g: 0, b: 0 };
        }

        return `rgb(${color.r}, ${color.g}, ${color.b})`;
    }

    document.addEventListener('DOMContentLoaded', function() {
        const cells = document.querySelectorAll('.pause-cell, .bonus-pause-cell');
        cells.forEach(cell => {
            const value = parseInt(cell.getAttribute('data-value'));
            if (!isNaN(value)) {
                cell.style.backgroundColor = getColorForPause(value);
            }
        });
    });

    if (is320) {
        document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(btn => {
            btn.addEventListener('shown.bs.tab', function (e) {
                const targetSelector = e.target.getAttribute('data-bs-target');
                if (targetSelector && targetSelector.startsWith('#tableTab_')) {
                    const field = targetSelector.substring(10);
                    document.getElementById("selectedTableInput").value = field;
                }
            });
        });
    }
</script>