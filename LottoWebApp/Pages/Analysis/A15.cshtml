@page
@model LottoWebApp.Pages.Analysis.A15Model
@{
    ViewData["Title"] = "1.5 Вывод 10 частых и редких чисел по дням недели";
    bool is320 = Model.Game == "320";
    var fields = is320 ? new[] { "B1", "B2" } : new[] { "B" };
    var daysOfWeekOrder = new[] { "понедельник", "вторник", "среда", "четверг", "пятница", "суббота", "воскресенье" };
}

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>
    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" asp-page-handler="DownloadCsv" class="d-inline-block">
        <input type="hidden" name="Game" value="@Model.Game" />
        <input type="hidden" name="DrawCount" value="@Model.DrawCount" />
        <input type="hidden" name="Direction" value="@Model.Direction" />
        <input type="hidden" name="Title" value="@ViewData["Title"]" />
        <input type="hidden" name="SelectedTable" id="selectedTableInput" value="" />
        <button class="btn btn-success mb-4">💾 Скачать таблицу (CSV)</button>
    </form>

    <button class="btn btn-info mb-4 ms-2" onclick="downloadChart()">📥 Скачать график (PNG)</button>

    <ul class="nav nav-tabs" role="tablist">
        @foreach (var field in fields)
        {
            var fieldData = is320 ? Model.ResultsByField[field] : Model.Results;
            var groupedData = is320 ? Model.GroupedByField[field] : Model.GroupedResults;

            <li class="nav-item" role="presentation">
                <button class="nav-link @(field == fields[0] ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tableTab_@field" type="button" role="tab">📋 Таблица @(is320? field : "")</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chartMain_@field" type="button" role="tab">📊 График @(is320? field : "")</button>
            </li>

            @foreach (var day in daysOfWeekOrder)
            {
                if (groupedData.ContainsKey(day))
                {
                    var id = day.Replace(" ", "_");
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab_@id@(is320 ? "_" + field : "")" type="button" role="tab">@day @(is320 ? "(" + field + ")" : "")</button>
                    </li>
                }
            }
        }
    </ul>

    <div class="tab-content mt-3">
        @foreach (var field in fields)
        {
            var fieldData = is320 ? Model.ResultsByField[field] : Model.Results;
            var groupedData = is320 ? Model.GroupedByField[field] : Model.GroupedResults;

            <div class="tab-pane fade @(field == fields[0] ? "show active" : "")" id="tableTab_@field" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-dark table-bordered text-center">
                        <thead>
                            <tr>
                                <th>День недели</th>
                                <th>№ Шара</th>
                                <th>Кол-во</th>
                                <th>Шанс</th>
                                <th>Тип</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in fieldData)
                            {
                                <tr>
                                    <td>@r.DayOfWeek</td>
                                    <td>@r.Number</td>
                                    <td>@r.Count</td>
                                    <td>@r.Chance</td>
                                    <td>@r.Type</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="chartMain_@field" role="tabpanel">
                <canvas id="chartMainCanvas_@field" style="width:100%; height:420px;"></canvas>
            </div>

            @foreach (var day in daysOfWeekOrder)
            {
                if (groupedData.ContainsKey(day))
                {
                    var id = day.Replace(" ", "_");
                    <div class="tab-pane fade" id="tab_@id@(is320 ? "_" + field : "")" role="tabpanel">
                        <canvas id="chart_@id@(is320 ? "_" + field : "")" style="width:100%; height:420px;"></canvas>
                    </div>
                }
            }
        }
    </div>
</div>

<script>
    const is320 = @is320.ToString().ToLower();
    const charts = {};
    let activeCanvasId = null;

    function decodeHtml(str) {
        const txt = document.createElement('textarea');
        txt.innerHTML = str;
        return txt.value;
    }

    const normalizeKey = (key) => key.trim().toLowerCase();

    const allData = {
        @foreach (var field in fields)
        {
                var fieldData = is320 ? Model.ResultsByField[field] : Model.Results;
                var groupedData = is320 ? Model.GroupedByField[field] : Model.GroupedResults;
                @:@Html.Raw(Json.Serialize(field)): {
                    @:labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(fieldData.Select(r => r.DayOfWeek + " №" + r.Number))),
                    @:values: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(fieldData.Select(r => r.Count))),
                    @:types: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(fieldData.Select(r => r.Type))),
                    @:grouped: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(groupedData.ToDictionary(kv => kv.Key, kv => kv.Value.Select(r => new object[] { r.Number, r.Count, r.Type }).ToArray())))
                @:},
        }
    };

    function createChart(canvasId, labels, values, types, title = null) {
        const canvas = document.getElementById(canvasId);
        if (!canvas || charts[canvasId]) return;

        const colors = types.map(t => decodeHtml(t) === "Частое" ? "rgba(255,99,132,0.85)" : "rgba(54,162,235,0.8)");

        charts[canvasId] = new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Количество выпадений',
                    data: values,
                    backgroundColor: colors,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { y: { beginAtZero: true } },
                plugins: {
                    title: title ? { display: true, text: title, font: { size: 16 } } : {},
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const type = decodeHtml(types[context.dataIndex]);
                                const value = context.parsed.y;
                                return `${type}: ${value} раз`;
                            }
                        }
                    }
                }
            }
        });
    }

    function createChartForDay(field, dayKey) {
        const canvasId = 'chart_' + dayKey.replace(/\s+/g, '_') + (is320 ? '_' + field : '');
        const canvas = document.getElementById(canvasId);
        if (!canvas || charts[canvasId]) return;

        const normKey = normalizeKey(dayKey);
        let dataArray = null;

        for (const [key, arr] of Object.entries(allData[field].grouped)) {
            if (normalizeKey(key) === normKey) {
                dataArray = arr.map(row => ({ Number: row[0], Count: row[1], Type: decodeHtml(row[2]) }));
                break;
            }
        }

        if (!dataArray || dataArray.length === 0) return;

        const frequent = dataArray.filter(x => x.Type === "Частое").sort((a, b) => b.Count - a.Count);
        const rare = dataArray.filter(x => x.Type === "Редкое").sort((a, b) => a.Count - b.Count);
        const sortedData = [...frequent, ...rare];

        createChart(canvasId, sortedData.map(x => x.Number.toString()), sortedData.map(x => x.Count), sortedData.map(x => x.Type), dayKey + (is320 ? ' (' + field + ')' : ''));
    }

    document.addEventListener('shown.bs.tab', function(e) {
        const target = e.target.getAttribute('data-bs-target');
        if (!target) return;

        if (target.startsWith('#tableTab_')) {
            const field = target.substring(10);
            document.getElementById("selectedTableInput").value = is320 ? field : "";
        } else if (target.startsWith('#chartMain_')) {
            const field = target.substring(11);
            const canvasId = 'chartMainCanvas_' + field;
            activeCanvasId = canvasId;
            createChart(canvasId, allData[field].labels, allData[field].values, allData[field].types);
        } else if (target.startsWith('#tab_')) {
            const parts = target.substring(5).split('_');
            const dayKey = parts.slice(0, -1).join(' ');
            const field = is320 ? parts[parts.length - 1] : Object.keys(allData)[0];
            const canvasId = 'chart_' + dayKey.replace(/\s+/g, '_') + (is320 ? '_' + field : '');
            activeCanvasId = canvasId;
            createChartForDay(field, dayKey);
        }
    });

    document.addEventListener('DOMContentLoaded', function() {
        const activeTab = document.querySelector('.nav-link.active');
        if (!activeTab) return;

        const target = activeTab.getAttribute('data-bs-target');
        setTimeout(() => {
            if (target.startsWith('#chartMain_')) {
                const field = target.substring(11);
                const canvasId = 'chartMainCanvas_' + field;
                activeCanvasId = canvasId;
                createChart(canvasId, allData[field].labels, allData[field].values, allData[field].types);
            }
        }, 100);
    });

    function downloadChart() {
        if (!activeCanvasId || !charts[activeCanvasId]) {
            alert("Сначала открой вкладку с графиком.");
            return;
        }

        const link = document.createElement("a");
        link.href = charts[activeCanvasId].toBase64Image();
        link.download = activeCanvasId + ".png";
        link.click();
    }
</script>