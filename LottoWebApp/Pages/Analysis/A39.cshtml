@page
@model LottoWebApp.Pages.Analysis.A39Model
@{
    ViewData["Title"] = "3.9 Карта выпадения чисел согласно билету закрытие";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <a href="/User/UserMainMenu" class="btn btn-secondary mb-4">⬅ Назад в меню</a>

    <form method="post" class="mb-4">
        <input type="hidden" name="Game" value="@Model.Game" />
        <div class="row">
            <div class="col-md-4">
                <label for="DrawCount" class="form-label">Количество тиражей (0 - все)</label>
                <input type="number" name="DrawCount" id="DrawCount" class="form-control" min="0" value="@(Model.DrawCount > 0 ? Model.DrawCount : 0)" />
            </div>
            <div class="col-md-4">
                <label for="Direction" class="form-label">Направление</label>
                <select name="Direction" id="Direction" class="form-select">
                    <option value="newToOld" selected="@(Model.Direction == "newToOld")">Сначала новые</option>
                    <option value="oldToNew" selected="@(Model.Direction == "oldToNew")">Сначала старые</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Построить карту закрытия</button>
                @if (Model.MatrixResults.Any())
                {
                    <button type="submit" asp-page-handler="DownloadCsv" class="btn btn-success w-100 mt-2">💾 Скачать CSV</button>
                }
            </div>
        </div>
    </form>

    @if (Model.MatrixResults.Any())
    {
        <div class="table-responsive">
            <table class="table table-dark table-bordered text-center">
                <thead>
                    <tr>
                        <th>Тираж</th>
                        <th>Дата</th>
                        @if (Model.HasTime)
                        {
                            <th>Время</th>
                        }
                        @for (int i = 1; i <= Model.Cols; i++)
                        {
                            <th>№@i</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.MatrixResults)
                    {
                        <tr>
                            @if (row.IsHeader)
                            {
                                <td class="header-cell">@row.Draw</td>
                                <td class="header-cell">@row.Date</td>
                                @if (Model.HasTime)
                                {
                                    <td class="header-cell">@row.Time</td>
                                }
                            }
                            else if (row.IsReset)
                            {
                            <td colspan="@(Model.HasTime ? 3 : 2)" class="reset-cell">Сброс матрицы</td>
                            }

                            else
                            {
                                <td class="empty-cell"></td>
                                <td class="empty-cell"></td>
                                @if (Model.HasTime)
                                {
                                    <td class="empty-cell"></td>
                                }
                            }
                            @for (int i = 1; i <= Model.Cols; i++)
                            {
                                var value = row.IsReset ? "" : (row.Cells.TryGetValue(i, out var cellValue) ? cellValue : "*");
                                <td class="@(row.IsReset ? "reset-cell" : "")">@value</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .header-cell {
        background-color: #495057;
        font-weight: bold;
    }

    .empty-cell {
        background-color: inherit;
        border: none;
    }

    .reset-cell {
        background-color: #6c757d;
        font-style: italic;
    }
</style>